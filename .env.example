# Copy to .env and adjust. NEVER commit .env (PRD §24.3 — no secrets in source).

# ---------- Database (PRD §16) ----------
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=talentlens_dev
POSTGRES_DB=talentlens
POSTGRES_PORT=5432
# Owner role — runs Prisma migrations (needs DDL rights).
DATABASE_URL=postgresql://talentlens:talentlens_dev@localhost:5432/talentlens?schema=public

# Restricted application role — what the API connects as at runtime.
# PRD §17.3 requires audit_logs to be append-only, and a table OWNER bypasses
# REVOKE in PostgreSQL, so the app must NOT connect as the owner.
# Local password is set by apps/api/scripts/grant-app-login.sql.
APP_DATABASE_URL=postgresql://talentlens_app:talentlens_app_dev@localhost:5432/talentlens?schema=public

# ---------- Redis (PRD §16 — session cache + BullMQ) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- Object storage (PRD §16 Table 16.1 — resumes) ----------
# Local development runs LocalStack (PRD §16.1). In production S3_ENDPOINT is
# left UNSET so the AWS SDK resolves the real regional endpoint, and
# credentials come from the pod's IAM role rather than these variables.
LOCALSTACK_PORT=4566
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=talentlens-resumes-dev
# LocalStack accepts any non-empty credentials; these are not secrets.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Antivirus scanning (PRD §20 stage 1) has NO environment variable. Phase 2
# ships the boundary with a pass-through implementation, and the binding lives
# in CommonModule so that swapping in a real ClamAV engine is a reviewed code
# change rather than something a misconfigured deployment can turn off.

# ---------- Core API ----------
API_PORT=3000
NODE_ENV=development

# ---------- Auth (PRD §24.1) ----------
# Access token 15 min, refresh token 7 days, rotating.
# Generate real values with: openssl rand -base64 48
# The two secrets MUST differ — sharing one would let an access token be
# replayed as a refresh token. The API refuses to start if they match.
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Interview scheduling links (FR6.2, Handoff decision D5) ----------
# Signs the single-purpose, expiring token in a candidate's scheduling link.
# Optional: falls back to JWT_REFRESH_SECRET, which keeps a fresh checkout
# working while still never matching JWT_ACCESS_SECRET — a link that sits in an
# inbox for days must not be interchangeable with a session token.
# There is no TTL setting: the link expires when the last offered slot ends.
SCHEDULING_TOKEN_SECRET=dev-only-change-me-scheduling

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:3000

# ---------- AI service (Phase 3 integration — reference stub, not a model) ----------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# Phase 3 binds AiScoringPort to PersistedAiProvider (DB reads + queue).
# The worker calls the Python service over HTTP; it is opt-in because it holds
# a Redis connection open and reaches an external process.
RESUME_WORKER_ENABLED=false
AI_SERVICE_TIMEOUT_MS=10000

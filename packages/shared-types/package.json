{
  "name": "@talentlens/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Types shared between apps/web and apps/api. Dual CJS/ESM build.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:cjs && pnpm build:esm && pnpm build:types && pnpm build:esm-marker",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:esm-marker": "node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}) + '\\n')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests in shared-types yet\" && exit 0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

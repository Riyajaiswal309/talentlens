# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# TypeScript must never emit into source. Guard against a misconfigured
# tsconfig re-introducing these (happened once in M2.1).
apps/web/src/**/*.js
apps/web/src/**/*.d.ts
apps/web/vite.config.js
apps/web/vite.config.d.ts

# environment — never commit real secrets (PRD §24.3)
.env
.env.local
.env.*.local

# python (apps/ai-service)
__pycache__/
*.py[cod]
.venv/
venv/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# prisma generated client (regenerated by `pnpm prisma:generate`)
apps/api/prisma/generated/

# test output
coverage/
